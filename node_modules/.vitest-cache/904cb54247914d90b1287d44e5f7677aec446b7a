,YAAY,KAAK;iBAEhC,oDAAC,0BAAD,EAAG,MAAM,GAAK;;;;;MACR;;;;cACF;;;;;eACR,iDAAC,eAAD;MACU;MACE;MACM;MAChB,UAAU;MACV,MAAK;KACN;;;;aACM;;;;;;GACN;;;;;EAEJ;;;;;;AAET","names":[],"ignoreList":[],"sources":["SeatMapPicker.tsx"],"sourcesContent":["import { useEffect, useId, useState } from 'react';\nimport { Armchair, Maximize2, X } from 'lucide-react';\nimport type { Seat, SeatingLayout } from '@/types';\n\ninterface SeatMapPickerProps {\n  layout: SeatingLayout;\n  imageUrl: string | null;\n  selectedSeatId: string | null;\n  onSelect: (seatId: string) => void;\n  title?: string;\n  size?: 'default' | 'large' | 'compact';\n  allowExpand?: boolean;\n  className?: string;\n}\n\ninterface MapBounds {\n  minX: number;\n  minY: number;\n  width: number;\n  height: number;\n}\n\nfunction seatMapBounds(layout: SeatingLayout): MapBounds {\n  if (!layout.seats.length) {\n    return { minX: 0, minY: 0, width: 1, height: 1 };\n  }\n\n  const padding = 0.035;\n  const minSeatX = Math.min(...layout.seats.map((seat) => seat.x - seat.width / 2));\n  const maxSeatX = Math.max(...layout.seats.map((seat) => seat.x + seat.width / 2));\n  const minSeatY = Math.min(...layout.seats.map((seat) => seat.y - seat.depth / 2));\n  const maxSeatY = Math.max(...layout.seats.map((seat) => seat.y + seat.depth / 2));\n  const minX = Math.max(0, minSeatX - padding);\n  const minY = Math.max(0, minSeatY - padding);\n  const maxX = Math.min(1, maxSeatX + padding);\n  const maxY = Math.min(1, maxSeatY + padding);\n\n  return {\n    minX,\n    minY,\n    width: Math.max(0.12, maxX - minX),\n    height: Math.max(0.12, maxY - minY),\n  };\n}\n\nfunction seatLabel(seat: Seat): string {\n  return `${seat.rowLabel}${seat.seatNumber ?? '—'}`;\n}\n\nfunction statusLabel(status: Seat['status']): string {\n  if (status === 'occupied') return 'Booked';\n  if (status === 'unknown') return 'Not sure';\n  return 'Available';\n}\n\nexport function SeatMapPicker({\n  layout,\n  imageUrl,\n  selectedSeatId,\n  onSelect,\n  title,\n  size = 'default',\n  allowExpand = false,\n  className = '',\n}: SeatMapPickerProps) {\n  const [expanded, setExpanded] = useState(false);\n  const dialogTitleId = useId();\n  const currentSeat = layout.seats.find((seat) => seat.id === selectedSeatId);\n  const bounds = seatMapBounds(layout);\n  const maxMapHeight = size === 'large' ? 680 : size === 'compact' ? 240 : 240;\n  const minMarkerWidth = size === 'large' ? 34 : size === 'compact' ? 18 : 26;\n  const maxMarkerWidth = size === 'large' ? 52 : size === 'compact' ? 28 : 44;\n  const minMarkerHeight = size === 'large' ? 38 : size === 'compact' ? 20 : 30;\n  const maxMarkerHeight = size === 'large' ? 48 : size === 'compact' ? 26 : 40;\n  const aspectRatio =\n    (bounds.width * layout.imageWidth) / Math.max(1, bounds.height * layout.imageHeight);\n\n  useEffect(() => {\n    if (!expanded) return;\n    const closeOnEscape = (event: KeyboardEvent) => {\n      if (event.key === 'Escape') setExpanded(false);\n    };\n    document.addEventListener('keydown', closeOnEscape);\n    return () => document.removeEventListener('keydown', closeOnEscape);\n  }, [expanded]);\n\n  const selectExpandedSeat = (seatId: string) => {\n    setExpanded(false);\n    onSelect(seatId);\n  };\n\n  return (\n    <div\n      className={`seat-map-picker${size === 'default' ? '' : ` seat-map-picker--${size}`} ${className}`}\n    >\n      {title && <h3 className=\"seat-map-title\">{title}</h3>}\n      {allowExpand && (\n        <button\n          className=\"btn btn--sm seat-map-expand\"\n          type=\"button\"\n          onClick={() => setExpanded(true)}\n        >\n          <Maximize2 size={12} />\n          Open full seat map\n        </button>\n      )}\n      <div\n        className=\"seat-map-viewport\"\n        style={{\n          aspectRatio: `${bounds.width * layout.imageWidth} / ${bounds.height * layout.imageHeight}`,\n          width: `min(100%, ${Math.round(aspectRatio * maxMapHeight)}px)`,\n        }}\n      >\n        {imageUrl ? (\n          <img\n            className=\"seat-map-image\"\n            src={imageUrl}\n            alt=\"\"\n            aria-hidden=\"true\"\n            style={{\n              left: `${(-bounds.minX / bounds.width) * 100}%`,\n              top: `${(-bounds.minY / bounds.height) * 100}%`,\n              right: 'auto',\n              bottom: 'auto',\n              width: `${100 / bounds.width}%`,\n              height: `${100 / bounds.height}%`,\n            }}\n          />\n        ) : (\n          <div className=\"seat-map-placeholder\" aria-hidden=\"true\" />\n        )}\n        {layout.seats.map((seat) => {\n          const selected = seat.id === selectedSeatId;\n          const label = seatLabel(seat);\n          const status = statusLabel(seat.status);\n          return (\n            <button\n              key={seat.id}\n              type=\"button\"\n              className={`seat-map-seat seat-map-seat--${seat.status} ${\n                selected ? 'is-selected' : ''\n              }`}\n              style={{\n                left: `${((seat.x - bounds.minX) / bounds.width) * 100}%`,\n                top: `${((seat.y - bounds.minY) / bounds.height) * 100}%`,\n                width: `clamp(${minMarkerWidth}px, ${Math.max(size === 'large' ? 3 : 1.5, Math.min(7, (seat.width / bounds.width) * 100))}%, ${maxMarkerWidth}px)`,\n                height: `clamp(${minMarkerHeight}px, ${Math.max(size === 'large' ? 3.5 : 1.5, Math.min(5, (seat.depth / bounds.height) * 100))}%, ${maxMarkerHeight}px)`,\n              }}\n              title={`Row ${seat.rowLabel}, seat ${seat.seatNumber ?? 'unknown'} · ${status}`}\n              aria-label={`Row ${seat.rowLabel}, seat ${seat.seatNumber ?? 'unknown'}, ${status}. View this seat.`}\n              aria-pressed={selected}\n              onClick={() => onSelect(seat.id)}\n            >\n              <Armchair className=\"seat-map-seat-icon\" aria-hidden=\"true\" />\n              <span className=\"seat-map-seat-label\">{label}</span>\n            </button>\n          );\n        })}\n      </div>\n      <div className=\"seat-map-legend\" role=\"group\" aria-label=\"Seat availability legend\">\n        <span><i className=\"is-available\" />Available</span>\n        <span><i className=\"is-occupied\" />Booked</span>\n        <span><i className=\"is-unknown\" />Not sure</span>\n        <span><i className=\"is-current\" />Viewing</span>\n      </div>\n      <p className=\"seat-map-current\">\n        {currentSeat\n          ? `Current view · ${seatLabel(currentSeat)}`\n          : `${layout.seats.length} seats detected · click any seat to see its view`}\n      </p>\n      {expanded && (\n        <div\n          className=\"seat-map-modal-backdrop\"\n          role=\"presentation\"\n          onMouseDown={(event) => {\n            if (event.target === event.currentTarget) setExpanded(false);\n          }}\n        >\n          <section\n            className=\"seat-map-modal\"\n            role=\"dialog\"\n            aria-modal=\"true\"\n            aria-labelledby={dialogTitleId}\n          >\n            <header className=\"seat-map-modal-header\">\n              <div>\n                <h2 id={dialogTitleId}>{title ?? 'Choose a seat'}</h2>\n                <p>Select a labeled seat to open its view. Booked seats are still viewable.</p>\n              </div>\n              <button\n                className=\"icon-btn\"\n                type=\"button\"\n                aria-label=\"Close full seat map\"\n                onClick={() => setExpanded(false)}\n              >\n                <X size={16} />\n              </button>\n            </header>\n            <SeatMapPicker\n              layout={layout}\n              imageUrl={imageUrl}\n              selectedSeatId={selectedSeatId}\n              onSelect={selectExpandedSeat}\n              size=\"large\"\n            />\n          </section>\n        </div>\n      )}\n    </div>\n  );\n}\n"],"file":"/src/components/viewer/SeatMapPicker.tsx"}